{
  "name": "voice-command-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hands-free voice control of a web app using only the browser's built-in Web Speech API. No API keys, no backend.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:text && vite",
    "build": "npm run build:text && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:text": "node scripts/build-text.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
